rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isMasterAdminEmail() {
      return request.auth.token.email != null && (
        request.auth.token.email == 'auzza38@gmail.com' ||
        request.auth.token.email == 'info.65seoulbbqnongkha@gmail.com' ||
        request.auth.token.email.lower() == 'auzza38@gmail.com' ||
        request.auth.token.email.lower() == 'info.65seoulbbqnongkha@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        isMasterAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()))
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'master_admin')
      );
    }

    // Admins index collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if (isAdmin() || isMasterAdminEmail()) && isValidId(adminId);
    }

    // User profiles (Self update, Admin manage)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(userId);
      allow update: if isSignedIn() && (
        isAdmin() ||
        request.auth.uid == userId
      );
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Item Master (173 items & custom additions) - Allows full stock management for logged-in staff & admin
    match /items/{itemId} {
      allow read: if true;
      allow create, update, delete: if (isAdmin() || isSignedIn()) && isValidId(itemId);
    }

    // Daily Stock Checks
    match /stockChecks/{checkId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(checkId);
      allow update: if isSignedIn() && isValidId(checkId);
      allow delete: if (isAdmin() || isSignedIn()) && isValidId(checkId);
    }

    // Purchases & Receipts (OCR and approval workflows)
    match /purchases/{purchaseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if (isAdmin() || isSignedIn()) && isValidId(purchaseId);
    }

    // Daily Sales records
    match /dailySales/{saleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if (isAdmin() || isSignedIn()) && isValidId(saleId);
    }

    // Daily Wages records
    match /dailyWages/{wageId} {
      allow read: if isSignedIn();
      allow create, update, delete: if (isAdmin() || isSignedIn()) && isValidId(wageId);
    }

    // Monthly Expenses (Water, Electricity, Rent, Depreciation, etc.)
    match /monthlyExpenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if (isAdmin() || isSignedIn()) && isValidId(expenseId);
    }

    // Immutable Audit Logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
